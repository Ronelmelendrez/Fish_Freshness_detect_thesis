# Copy to `.env.local` and adjust. Values prefixed with EXPO_PUBLIC_ are
# inlined at bundle time.

# 'tflite' (legacy on-device) or 'roboflow' (hosted gateway)
EXPO_PUBLIC_MODEL_BACKEND=roboflow

# Required when EXPO_PUBLIC_MODEL_BACKEND=roboflow.
EXPO_PUBLIC_GATEWAY_URL=
# Optional app token checked by the gateway.
EXPO_PUBLIC_GATEWAY_APP_TOKEN=

# combineResults strategy: 'severe-wins' | 'weighted'
EXPO_PUBLIC_COMBINE_STRATEGY=severe-wins

# Persist completed scans to local history
EXPO_PUBLIC_HISTORY_ENABLED=true
# Show the first-run onboarding explainer
EXPO_PUBLIC_ONBOARDING_ENABLED=true

# Optional: survey submission endpoint (async export to CSV otherwise)
EXPO_PUBLIC_SURVEY_ENDPOINT=

# This app uses React Navigation (not expo-router). The CLI auto-detects
# expo-router if it is resolvable anywhere in the module graph (e.g. a stray
# global install) and then refuses to bundle @react-navigation imports, so
# opt out of that check explicitly.
EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1